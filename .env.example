# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MIDNIGHT NETWORK CONFIGURATION (Official Midnight Preview Documentation)
# Node RPC: Verified live via JSON-RPC system_health
MIDNIGHT_NODE_RPC_URL="https://rpc.preview.midnight.network"
VITE_MIDNIGHT_NODE_RPC_URL="https://rpc.preview.midnight.network"

# GraphQL Indexer: Verified live via GraphQL schema introspection
MIDNIGHT_INDEXER_URL="https://indexer.preview.midnight.network/api/v3/graphql"
VITE_MIDNIGHT_INDEXER_URL="https://indexer.preview.midnight.network/api/v3/graphql"

# Proof Server: Verified live on port 6300 (version 7.0.0-rc.1)
MIDNIGHT_PROOF_SERVER_URL="http://localhost:6300"
VITE_MIDNIGHT_PROOF_SERVER_URL="http://localhost:6300"

# Network Identifier
MIDNIGHT_NETWORK_ID="Midnight Preview"
VITE_MIDNIGHT_NETWORK_ID="Midnight Preview"

# Deployed Compact Contract Address (Unset until income_verifier.compact is deployed on-chain)
MIDNIGHT_CONTRACT_ADDRESS=
VITE_MIDNIGHT_CONTRACT_ADDRESS=

