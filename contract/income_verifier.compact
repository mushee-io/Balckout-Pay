// ============================================================================
// BLACKOUT — MIDNIGHT NETWORK COMPACT SMART CONTRACT
// Language: Compact (Midnight Network ZK Smart Contract DSL)
//
// Purpose: Privacy-preserving income threshold verification.
// Security model (v2):
//   1. A verifier registers an immutable request once.
//   2. A prover may submit exactly one result for that registered request.
//   3. The proof circuit MUST use the registered threshold and verifier key.
//   4. Results are append-only and cannot overwrite the registration record.
//   5. Private monthly income and salt never enter public ledger state.
// ============================================================================

pragma language_version >= 0.20.0;

import CompactStandardLibrary;

// Public request registration. `is_verified` and `commitment` are intentionally
// initialized to false/default here and never mutated; final outcomes live in
// the append-only `results` map below.
export struct VerificationRecord {
    request_id: Bytes<32>;
    required_income: Uint<64>;
    is_verified: Boolean;
    timestamp: Uint<64>;
    verifier_pk: Bytes<32>;
    commitment: Bytes<32>;
}

// Immutable request registrations and append-only final results.
export ledger records: Map<Bytes<32>, VerificationRecord>;
export ledger results: Map<Bytes<32>, VerificationRecord>;

// Private witness definitions (executed locally off-chain inside the prover).
witness get_private_monthly_income(): Uint<64>;
witness get_private_income_salt(): Bytes<32>;

// ZK Circuit: proves income threshold without revealing income.
export circuit prove_income_threshold(
    request_id: Bytes<32>,
    required_income: Uint<64>,
    verifier_pk: Bytes<32>,
    timestamp: Uint<64>
): Boolean {
    const public_request_id: Bytes<32> = disclose(request_id);
    const public_required_income: Uint<64> = disclose(required_income);
    const public_verifier_pk: Bytes<32> = disclose(verifier_pk);
    const public_timestamp: Uint<64> = disclose(timestamp);

    // A proof is valid only for an already-registered request.
    assert(records.member(public_request_id), "Request is not registered");

    // One request -> one final proof result. This is the protocol-level replay
    // barrier; browser storage is never relied upon for replay security.
    assert(!results.member(public_request_id), "Request already has a proof result");

    const registered: VerificationRecord = records.lookup(public_request_id);

    // Bind the proof to the verifier's immutable registration. A caller cannot
    // lower the threshold or substitute another verifier when proving.
    assert(registered.required_income == public_required_income, "Registered threshold mismatch");
    assert(registered.verifier_pk == public_verifier_pk, "Registered verifier mismatch");

    // Private witness state exists only inside the zero-knowledge circuit.
    const private_income: Uint<64> = get_private_monthly_income();
    const private_salt: Bytes<32> = get_private_income_salt();

    const computed_commitment: Bytes<32> = persistentHash<[Uint<64>, Bytes<32>]>([private_income, private_salt]);

    // Only the qualification boolean and witness commitment cross the
    // disclosure boundary. The exact income and salt remain private.
    const is_satisfied: Boolean = disclose(private_income >= registered.required_income);
    const disclosed_commitment: Bytes<32> = disclose(computed_commitment);

    // Append a final result under the same request id. Never update the
    // registration Map entry; this keeps request policy immutable.
    results.insert(public_request_id, VerificationRecord {
        request_id: public_request_id,
        required_income: registered.required_income,
        is_verified: is_satisfied,
        timestamp: public_timestamp,
        verifier_pk: registered.verifier_pk,
        commitment: disclosed_commitment
    });

    return is_satisfied;
}

// Verifier registration: a request id may be registered exactly once.
export circuit register_verification_request(
    request_id: Bytes<32>,
    required_income: Uint<64>,
    verifier_pk: Bytes<32>,
    timestamp: Uint<64>
): [] {
    const public_request_id: Bytes<32> = disclose(request_id);

    assert(!records.member(public_request_id), "Request id already registered");
    assert(!results.member(public_request_id), "Request id already finalized");

    records.insert(public_request_id, VerificationRecord {
        request_id: public_request_id,
        required_income: disclose(required_income),
        is_verified: false,
        timestamp: disclose(timestamp),
        verifier_pk: disclose(verifier_pk),
        commitment: default<Bytes<32>>
    });
    return [];
}
