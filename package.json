{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run midnight:compile && npm run midnight:assets",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run midnight:compile && npm run midnight:assets",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js contract/build contract/build-safe contract/blackout_safe.preview.compact public/keys public/zkir public/zk-artifacts/blackout-safe",
    "midnight:compile:verify": "node scripts/compile-compact.mjs",
    "midnight:compile:safe": "node scripts/compile-safe.mjs",
    "midnight:compile": "npm run midnight:compile:verify && npm run midnight:compile:safe",
    "midnight:deploy": "tsx scripts/deploy-midnight.ts",
    "midnight:finalize": "tsx scripts/finalize-midnight.ts",
    "midnight:check": "tsx scripts/midnight-check.ts",
    "midnight:assets": "node scripts/copy-zk-artifacts.mjs && node scripts/copy-safe-zk-artifacts.mjs",
    "prelint": "npm run midnight:compile",
    "lint": "tsc --noEmit",
    "pretest": "npm run midnight:compile",
    "test": "tsx src/tests/privacy.test.ts && tsx src/tests/hardening.test.ts",
    "build:verified": "npm run build",
    "ci": "npm run midnight:compile && npm run midnight:assets && tsc --noEmit && tsx src/tests/privacy.test.ts && tsx src/tests/hardening.test.ts && vite build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-wasm": "^3.6.0"
  }
}
